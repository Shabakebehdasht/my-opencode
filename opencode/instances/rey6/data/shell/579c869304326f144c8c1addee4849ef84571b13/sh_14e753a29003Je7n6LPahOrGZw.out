=== build-env-e2e.sh ===
#!/usr/bin/env bash
# Build .env.e2e from .env.e2e.example, copying secret VALUES straight from .env
# without ever printing them (the terminal masks output, so a read-and-rewrite
# approach would write literal "***" into the file).
set -euo pipefail
cd "$(dirname "$0")/.."

DEV=.env
E2E=.env.e2e
EXAMPLE=.env.e2e.example

[ -f "$DEV" ] || { echo "missing $DEV"; exit 1; }
[ -f "$EXAMPLE" ] || { echo "missing $EXAMPLE"; exit 1; }

# value_of KEY FILE  -> prints the raw value, nothing else
value_of() {
  grep -E "^$1=" "$2" | head -1 | cut -d= -f2-
}

cp "$EXAMPLE" "$E2E"

for key in APP_KEY DB_PASSWORD REDIS_PASSWORD; do
  val="$(value_of "$key" "$DEV")"
  if [ -n "$val" ] && [ "$val" != "***" ]; then
    # BSD/GNU sed both fine here: escape the delimiter and any '&'
    escaped=$(printf '%s' "$val" | sed -e 's/[\/&]/\\&/g')
    sed -i.bak "s|^${key}=.*|${key}=${escaped}|" "$E2E"
    rm -f "$E2E.bak"
  else
    echo "WARNING: no usable $key in $DEV"
  fi
done

# DB_USERNAME, if present in dev
dbuser="$(value_of DB_USERNAME "$DEV")"
if [ -n "$dbuser" ] && [ "$dbuser" != "***" ]; then
  escaped=$(printf '%s' "$dbuser" | sed -e 's/[\/&]/\\&/g')
  sed -i.bak "s|^DB_USERNAME=.*|DB_USERNAME=${escaped}|" "$E2E"
  rm -f "$E2E.bak"
fi

# Report only lengths / non-secret settings — never the values.
echo "--- .env.e2e written ---"
for key in APP_KEY DB_PASSWORD REDIS_PASSWORD; do
  v="$(value_of "$key" "$E2E")"
  echo "$key length: ${#v}"
done
echo "DB_DATABASE: $(value_of DB_DATABASE "$E2E")"
echo "APP_LOCALE:  $(value_of APP_LOCALE "$E2E")"
echo "TEST_N_CODE: $(value_of TEST_N_CODE "$E2E")"
=== .env.e2e.example ===
APP_ENV=local
# APP_LOCALE=fa is MANDATORY: e2e specs assert Persian pagination/validation text.
# Without it Laravel falls back to `en` and 11 tests fail (Showing… / English validation messages).
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_KEY=
APP_NAME=h-dashboard
APP_URL=http://localhost:8001

# ── Trusted proxies (#855) ──
# Leave EMPTY for a direct nginx+FPM deployment — nothing is trusted, so a
# client-supplied X-Forwarded-Host/Proto/Port/Prefix is ignored.
# If a proxy (Cloudflare, a load balancer) IS in front of the app, pin its
# CIDR ranges here, comma-separated, e.g.:
#   TRUSTED_PROXIES=173.245.48.0/20,103.21.244.0/22
# Then run `php artisan config:clear` (or `optimize`): a cached config freezes
# this value at boot, so editing .env alone has no effect.
TRUSTED_PROXIES=
# Hostnames this app answers for, comma-separated. Used as the trustHosts()
# allowlist that makes a wrong TRUSTED_PROXIES fail closed. Defaults to APP_URL
# when left empty — set it explicitly in production if you serve other names.
TRUSTED_HOSTS=
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=h_dashboard_e2e
DB_USERNAME=<same as dev>
DB_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=<same as dev>
CACHE_STORE=array
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
CACHE_PREFIX=h_dashboard_e2e
TEST_PASSWORD=12345678
TEST_N_CODE=4411015056
TEST_UNIT_MANAGER_N_CODE=6275537615
TEST_EXPERT_N_CODE=0023548258
TEST_REGULAR_USER_N_CODE=0041368464
BASE_URL=http://localhost:8001
