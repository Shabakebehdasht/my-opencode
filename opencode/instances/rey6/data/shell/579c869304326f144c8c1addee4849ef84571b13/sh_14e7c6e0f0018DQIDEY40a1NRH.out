     public function test_accept_ticket_out_of_scope_404(): void
     {
-        ['user' => $user] = $this->createUserWithUnit(['view_assigned_tickets']);
+        ['user' => $user] = $this->createUserWithUnit(['view_assigned_tickets', 'create_ticket']);
