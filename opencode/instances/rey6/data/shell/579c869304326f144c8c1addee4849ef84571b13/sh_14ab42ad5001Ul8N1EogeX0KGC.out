+                    \Illuminate\Support\Facades\DB::raw('ST_AsGeoJSON(boundaries.boundary) as geojson'),
+                ])
                 ->get()
                 ->map(fn($r) => [
                     'id' => $r->id,
                     'name' => $r->name,
-                    'geojson' => $r->boundary?->geojson,
+                    'geojson' => $r->geojson,
                 ])
                 ->filter(fn($r) => $r['geojson'])
                 ->values()
