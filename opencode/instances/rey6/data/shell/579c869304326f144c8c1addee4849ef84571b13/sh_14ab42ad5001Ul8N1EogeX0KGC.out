+            // baseline anchors for this anonymous component.
+            return Region::whereIn('regions.id', $this->selectedRegions)
+                ->whereNotNull('regions.boundary_id')
+                ->join('boundaries', 'regions.boundary_id', '=', 'boundaries.id')
+                ->select([
