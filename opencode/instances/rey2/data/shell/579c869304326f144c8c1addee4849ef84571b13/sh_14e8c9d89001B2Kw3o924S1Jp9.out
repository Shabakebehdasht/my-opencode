diff --git a/bootstrap/app.php b/bootstrap/app.php
index 570be380..7606dbfc 100644
--- a/bootstrap/app.php
+++ b/bootstrap/app.php
@@ -12,6 +12,7 @@
 use Illuminate\Foundation\Configuration\Exceptions;
 use Illuminate\Foundation\Configuration\Middleware;
 use Illuminate\Http\Request;
+use Illuminate\Session\Middleware\AuthenticateSession;
 use Laravel\Sanctum\Http\Middleware\CheckAbilities;
 use Laravel\Sanctum\Http\Middleware\CheckForAnyAbility;
 use Sentry\Laravel\Integration;
@@ -77,6 +78,14 @@
             'ability' => CheckForAnyAbility::class,
         ]);
         $middleware->web(append: [
+            // #1004: the mechanism behind Auth::logoutOtherDevices(). It keeps
+            // the account's password hash in the session and ends the session
+            // once that hash no longer matches — which is what makes other
+            // devices' cookies die after a password change. Without it the
+            // call in changePassword() is a no-op. Registered before
+            // LastUserActivity so a stale session is dropped before it can be
+            // recorded as activity.
+            AuthenticateSession::class,
             SecurityHeaders::class,
             LastUserActivity::class,
             RequestId::class,
diff --git a/resources/views/livewire/auth/changepassword.blade.php b/resources/views/livewire/auth/changepassword.blade.php
index da3ba060..33b35e41 100644
--- a/resources/views/livewire/auth/changepassword.blade.php
+++ b/resources/views/livewire/auth/changepassword.blade.php
@@ -34,6 +34,12 @@ public function changePassword(): void
             ]);
         }
 
+        // #1004: بستن نشست های وبِ دیگر روی دستگاه ها، پیش از تغییر رمز. این متد
+        // رمز فعلی را وریفای می کند، پس باید پیش از ذخیرهٔ رمز جدید اجرا شود.
+        // با FQCN صدا زده می شود تا افزودنِ یک import، شمارهٔ خطِ رکوردهای
+        // phpstan-baseline این فایل را جابجا نکند.
+        \Illuminate\Support\Facades\Auth::logoutOtherDevices($this->currentPassword);
+
         // تغییر رمز و ذخیره‌سازی
         $user->password = Hash::make($this->newPassword);
         $user->save();
