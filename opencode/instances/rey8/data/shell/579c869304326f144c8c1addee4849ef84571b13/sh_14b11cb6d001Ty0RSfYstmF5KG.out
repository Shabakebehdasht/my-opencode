=== c8f99232 (1107) blade diff ===
commit c8f992324c82ef1600f51d164bd0b9b088ada2f9
Author: Shabakebehdasht <Shabakebehdasht@users.noreply.github.com>
Date:   Sat Oct 17 11:16:41 2026 +0000

    fix(users): revoke the target's Sanctum tokens on an admin password reset
    
    `updateUser()` wrote the password but left every existing token valid, while
    the self-service path (`auth/changepassword`) already calls `tokens()->delete()`
    (#678). The admin reset now revokes **all** of the target's tokens too, guarded
    on an actually-changed password so a plain profile/role edit keeps devices
    logged in. All tokens die (including `map-dashboard`), matching the self-service
    path — see the expert comment's option الف-۱.
    
    Scope note: the raw issue's "add POST /api/logout" step is intentionally NOT
    here — that is issue #1071 verbatim.
    
    docs/agents/api-auth.md: the "revoked on password change (#678)" contract now
    names both paths, the all-tokens decision, and the no-password guard.
    
    Product impact: the target's Flutter session ends and must re-login.
    
    Closes #1030

diff --git a/resources/views/livewire/users/index.blade.php b/resources/views/livewire/users/index.blade.php
index 32106567..1e31235b 100644
--- a/resources/views/livewire/users/index.blade.php
+++ b/resources/views/livewire/users/index.blade.php
@@ -357,18 +357,34 @@ public function updateUser(): void
 
             $data = ['n_code' => $this->n_code];
 
+            $passwordChanged = (bool) $this->password;
+
             if ($this->password) {
                 $data['password'] = bcrypt($this->password);
             }
 
             $user->update($data);
+
+            // Issue #1030: an admin password reset must revoke the target's
+            // Sanctum tokens, exactly like the self-service path
+            // (`auth/changepassword`) already does. Guarded on an
+            // actually-changed password: a plain profile/role edit must not log
+            // the user's devices out. Every token dies (including
+            // `map-dashboard`) so both password-change paths stay in lockstep —
+            // see `docs/agents/api-auth.md`.
+            if ($passwordChanged) {
+                $user->tokens()->delete();
+            }
+
             $user->roles()->sync($this->role_ids ?? []);
             $user->syncPermissions($this->user_permissions ?? []);
             $user->units()->sync($this->unit_ids ?? []);
             app(AccessService::class)->clearCache($user);
 
             $this->resetForm();
-            $this->success('کاربر با موفقیت ویرایش شد.');
+            $this->success($passwordChanged
+                ? 'کاربر با موفقیت ویرایش شد. با تغییر رمز، نشست‌های فعال کاربر بسته شد.'
+                : 'کاربر با موفقیت ویرایش شد.');
         } catch (ValidationException $e) {
             foreach ($e->validator->errors()->all() as $error) {
                 $this->error($error, position: 'toast-bottom');

